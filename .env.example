# ==============================================================================
# 🛡️ StockPilot — Global Docker Environment Configuration Template
# Copy this file to '.env' for local development or customize for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_DB=stockpilot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_123
# Host port exposed during development (ignored in production)
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ☕ Spring Boot Backend Settings
# ------------------------------------------------------------------------------
# Port inside the container
BACKEND_CONTAINER_PORT=8999
# Port mapped to the host machine in dev mode
BACKEND_PORT=8999
# Remote debug JDWP port for IDE debugging in dev mode
BACKEND_DEBUG_PORT=5005

# Hibernate DDL strategy: 'update' for dev, 'validate' or 'none' for production
JPA_DDL_AUTO=update

# Database Seeding: 'true' creates demo users (admin, manager, user) and products
SEED_ENABLED=true

# JWT Authentication
# In production, generate a cryptographically secure key of at least 32 characters
JWT_SECRET=stockpilot-dev-jwt-secret-key-must-be-min-32-chars-long-1234567890
JWT_ISSUER=stockpilot
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# Allowed CORS Origins (comma-separated list of frontends)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ------------------------------------------------------------------------------
# ⚛️ Frontend & Reverse Proxy Settings
# ------------------------------------------------------------------------------
# Dev Vite server port
FRONTEND_PORT=5173

# Production HTTP / HTTPS entry ports
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443

# Internal proxy target from frontend container to backend container
VITE_BACKEND_URL=http://backend:8999

# ------------------------------------------------------------------------------
# ⚙️ Production Resource Limits (Used by docker-compose.prod.yml)
# ------------------------------------------------------------------------------
POSTGRES_CPU_LIMIT=1.5
POSTGRES_MEM_LIMIT=1024M
BACKEND_CPU_LIMIT=2.0
BACKEND_MEM_LIMIT=1024M
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=256M

# ------------------------------------------------------------------------------
# 🐳 Docker Hub & Registry Configuration
# ------------------------------------------------------------------------------
# Docker Hub account or organization
DOCKERHUB_USERNAME=your_dockerhub_username
# Docker Hub Personal Access Token (PAT) for CI/CD authentication
DOCKERHUB_TOKEN=your_dockerhub_access_token

# Explicit version-tagged images used by docker-compose.prod.yml (NO :latest)
# Example: your_dockerhub_username/stockpilot-backend:v1.0.0 or staging-a1b2c3d
DOCKER_IMAGE_BACKEND=your_dockerhub_username/stockpilot-backend:v1.0.0
DOCKER_IMAGE_FRONTEND=your_dockerhub_username/stockpilot-frontend:v1.0.0

