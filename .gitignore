# ==============================================================================
# 🛡️ StockPilot — Root .gitignore (Monorepo Backend + Frontend)
# ==============================================================================

# OS & Temp files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated
.sts4-cache
.nb-gradle/
/nbproject/private/

# Backend (Spring Boot / Maven)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Frontend (Node / React / Next / Vite)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
