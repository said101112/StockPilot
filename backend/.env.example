# ==============================================================================
# StockPilot Backend Environment Variables Template
# Copy this file to .env and customize for your environment
# ==============================================================================

# Server Port
PORT=8999

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/stockpilot_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JPA / Hibernate (Use 'validate' or 'none' in production)
JPA_DDL_AUTO=update

# JWT Authentication (MUST be a random secret of at least 32 characters in production)
JWT_SECRET=production-secret-must-be-min-32-chars-random-generated-key-here
JWT_ISSUER=stockpilot
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# CORS Allowed Origins (Comma-separated in production, e.g. https://app.stockpilot.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial Data Seeding (Set to false in production)
SEED_ENABLED=true
